# Copy to .env and fill in. .env is gitignored — never commit the token.
#
# 1. Create an internal integration: https://www.notion.so/my-integrations
#    ("New integration" → Internal → capabilities: Read + Update + Insert content)
# 2. Create ONE page in Notion that will hold the digest forever.
# 3. On that page: ••• menu → Connections → add your integration.
# 4. Copy the page id from its URL — the 32 hex chars after the last dash,
#    e.g. notion.so/My-Digest-1a2b3c4d5e6f7890abcdef1234567890
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PAGE_ID=1a2b3c4d5e6f7890abcdef1234567890
