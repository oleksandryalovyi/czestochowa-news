<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.rssnews.digest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/user/Documents/Pets/rss-news/digest.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/user/Documents/Pets/rss-news</string>
    <!-- 07:55 local, just before the 08:13 Claude task reads latest.json.
         18:55 local, a second same-day refresh (evening digest / Notion update). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>55</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>55</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/user/Documents/Pets/rss-news/logs/digest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user/Documents/Pets/rss-news/logs/digest.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
